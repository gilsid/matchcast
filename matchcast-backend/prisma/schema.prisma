generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  tournaments  Tournament[]
}

model Tournament {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  sport       String
  format      String   @default("knockout") // "knockout" | "round_robin" (v2)
  status      String   @default("draft")    // "draft" | "ongoing" | "finished"
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  teams       Team[]
  matches     Match[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  seed         Int?
  matchesHome    Match[]    @relation("HomeTeam")
  matchesAway    Match[]    @relation("AwayTeam")
  matchesWon     Match[]    @relation("WinnerTeam")
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  matchOrder   Int        // urutan pertandingan dalam satu babak
  homeTeamId   String?
  homeTeam     Team?      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String?
  awayTeam     Team?      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int?
  awayScore    Int?
  winnerTeamId String?
  winnerTeam   Team?     @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  scheduledAt  DateTime?
  status       String     @default("scheduled") // "scheduled" | "ongoing" | "finished"

  @@index([tournamentId, round, matchOrder])
}